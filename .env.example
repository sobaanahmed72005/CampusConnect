# ==========================================
# CampusConnect Production & Dev Environment Template
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS
# ==========================================

# Gateway & Server Port
PORT=5000
NODE_ENV=production

# Frontend Origin URL (CORS & Cookie Scope)
FRONTEND_URL=https://campusconnect.edu.pk

# Database Configuration (Managed PostgreSQL VPC Private Subnet)
DB_HOST=postgres.production.internal
DB_PORT=5432
DB_NAME=campusconnect_prod
DB_USER=campusconnect_app
DB_PASSWORD=YOUR_SECURE_PRODUCTION_DB_PASSWORD_HERE
DB_SSL=true

# Cryptographic Token Secrets (Must be 256-bit random keys)
JWT_SECRET=YOUR_SECURE_256BIT_RANDOM_JWT_SECRET_KEY_HERE

# Static Uploads Path
UPLOAD_DIRECTORY=uploads/
